{{- $pages := where site.RegularPages "Params.searchHidden" "ne" true -}}
{
  "version": "https://jsonfeed.org/version/1",
  "title": {{ site.Title | jsonify }},
  "home_page_url": {{ site.BaseURL | jsonify }},
  "feed_url": {{ (print site.BaseURL "index.json") | jsonify }},
  "items": [
    {{- range $i, $p := $pages -}}
    {{- if gt $i 0 }},{{ end }}
    {{- $rawBody := $p.RawContent | replaceRE `(?s)\{\{<[^>]+>\}\}` " " | replaceRE `(?s)\{\{%[^%]+%\}\}` " " | plainify -}}
    {
      "id": {{ $p.Permalink | jsonify }},
      "url": {{ $p.Permalink | jsonify }},
      "title": {{ $p.Title | jsonify }},
      "date_published": {{ $p.Date.Format "2006-01-02T15:04:05Z07:00" | jsonify }},
      "section": {{ $p.Section | jsonify }},
      "summary": {{ ($p.Params.summary | default $p.Description | default $p.Summary | plainify) | jsonify }},
      "body_text": {{ $rawBody | jsonify }},
      "tags": {{ ($p.Params.tags | default (slice)) | jsonify }}
    }
    {{- end -}}
  ]
}
